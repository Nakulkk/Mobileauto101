<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<suite name="Ccst" verbose="3" parallel="tests" thread-count="3" data-provider-thread-count="4">
    <listeners>
        <listener class-name="reports.ExtentTestLisner"></listener>
    </listeners>
    <test name="Chrome" >
        <parameter name="browser" value="chrome"></parameter>
        <classes>
            <class name="test.LoginSauceemo"/>
        </classes>
    </test>

    <test name="Edge">
        <parameter name="browser" value="Edge" ></parameter>
        <classes>
            <class name="test.LoginSauceemo"/>
        </classes>
    </test>

    <test name="FireFox">
        <parameter name="browser" value="firefox"></parameter>
        <classes>
            <class name="test.LoginSauceemo"/>
        </classes>
    </test>

</suite>